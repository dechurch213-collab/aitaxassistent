{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RagRetrievalRequest",
  "description": "C4: Запрос orchestrator -> rag-service POST /retrieval",
  "type": "object",
  "required": ["session_id", "query", "language"],
  "properties": {
    "session_id": {"type": "string"},
    "query": {"type": "string", "minLength": 1},
    "language": {"type": "string", "enum": ["ru", "kk"]},
    "top_n_vector": {"type": "integer", "default": 20, "minimum": 5, "maximum": 50},
    "top_n_final": {"type": "integer", "default": 4, "minimum": 1, "maximum": 10},
    "exclude_articles": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Статьи, уже раскрытые в текущей теме"
    },
    "hints": {
      "type": "object",
      "properties": {
        "entity": {"type": "string"},
        "taxpayer_type": {"type": "string"}
      }
    }
  }
}
