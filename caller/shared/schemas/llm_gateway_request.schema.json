{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LlmGatewayRequest",
  "description": "C6: Запрос orchestrator -> llm-gateway POST /v1/chat/completions (OpenAI-compatible + расширения)",
  "type": "object",
  "required": ["model", "messages"],
  "properties": {
    "model": {"type": "string"},
    "stream": {"type": "boolean", "default": true},
    "temperature": {"type": "number", "minimum": 0, "maximum": 1},
    "max_tokens": {"type": "integer"},
    "response_format": {
      "type": "object",
      "properties": {"type": {"type": "string", "enum": ["json_object", "text"]}}
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"type": "string", "enum": ["system", "user", "assistant"]},
          "content": {"type": "string"}
        }
      }
    },
    "x_session_id": {"type": "string"},
    "x_cache_keys": {
      "type": "object",
      "properties": {
        "system_hash": {"type": "string"},
        "rag_hash": {"type": "string"}
      }
    }
  }
}
