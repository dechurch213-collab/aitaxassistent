{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SttResult",
  "description": "C1: Результат STT (media-gateway -> orchestrator, поле payload события utterance_final)",
  "type": "object",
  "required": ["session_id", "turn_id", "language", "text", "confidence"],
  "properties": {
    "session_id": {"type": "string"},
    "turn_id": {"type": "integer", "minimum": 0},
    "language": {"type": "string", "enum": ["ru", "kk", "unknown"]},
    "language_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "text": {"type": "string"},
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "exp(avg_logprob) сегмента; пороги в orchestrator.yaml"
    },
    "no_speech_prob": {"type": "number", "minimum": 0, "maximum": 1},
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["w", "c"],
        "properties": {
          "w": {"type": "string"},
          "c": {"type": "number", "minimum": 0, "maximum": 1},
          "t0": {"type": "number"},
          "t1": {"type": "number"}
        }
      }
    },
    "duration_ms": {"type": "integer", "minimum": 0},
    "model": {"type": "string"}
  }
}
