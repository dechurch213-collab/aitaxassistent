{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrchestratorEvents",
  "description": "C2: WS-события media-gateway -> orchestrator (envelope)",
  "type": "object",
  "required": ["event", "session_id"],
  "properties": {
    "event": {
      "type": "string",
      "enum": ["utterance_final", "call_started", "call_ended", "dtmf", "gateway_reconnected"]
    },
    "session_id": {"type": "string"},
    "turn_id": {"type": "integer", "minimum": 0},
    "payload": {
      "description": "Для utterance_final — SttResult (см. stt_result.schema.json); для остальных — метаданные",
      "type": ["object", "null"]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"event": {"const": "utterance_final"}}},
      "then": {
        "required": ["turn_id", "payload"],
        "properties": {"payload": {"$ref": "stt_result.schema.json"}}
      }
    },
    {
      "if": {"properties": {"event": {"const": "call_started"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["caller", "uniqueid", "codec"],
            "properties": {
              "caller": {"type": "string"},
              "uniqueid": {"type": "string"},
              "codec": {"type": "string"}
            }
          }
        }
      }
    }
  ]
}
